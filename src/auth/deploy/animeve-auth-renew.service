[Unit]
Description=Renew mpv-AnimeFusion authorization HTTPS certificate
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/mpv-animefusion-auth/deploy
ExecStart=/usr/bin/docker compose --profile maintenance run --rm certbot renew --quiet
ExecStart=/usr/bin/docker compose exec -T nginx nginx -s reload
