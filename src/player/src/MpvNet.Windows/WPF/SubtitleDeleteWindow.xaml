<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MpvNet.Windows.UI"
        x:Class="MpvNet.Windows.WPF.SubtitleDeleteWindow"
        Title="删除字幕" Style="{StaticResource MatchWindow}" Width="500"
        SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="22">
        <TextBlock Text="确认从这部作品的字幕列表中删除？" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding FileName}" TextWrapping="Wrap" Margin="0,12,0,16" />
        <CheckBox x:Name="DeleteFile" Content="同时删除本地文件" IsChecked="False"
                  Foreground="{Binding Foreground, Source={x:Static ui:Theme.Current}}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" IsCancel="True" IsDefault="True" Margin="0,0,8,0" />
            <Button Content="删除" Click="Delete_Click" />
        </StackPanel>
    </StackPanel>
</Window>
