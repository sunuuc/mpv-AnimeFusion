<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MpvNet.Windows.WPF.TraktMatchWindow"
        Title="匹配 Trakt" Width="540" SizeToContent="Height" MinWidth="460" MinHeight="220" MaxHeight="850"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Foreground="{Binding Theme.Foreground}" Background="{Binding Theme.Background}" FontSize="14"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{Binding Theme.Foreground}" />
            <Setter Property="Background" Value="{Binding Theme.MenuHighlight}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".8" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{Binding Theme.Foreground}" />
            <Setter Property="CaretBrush" Value="{Binding Theme.Foreground}" />
            <Setter Property="Background" Value="{Binding Theme.MenuBackground}" />
            <Setter Property="BorderBrush" Value="{Binding Theme.MenuHighlight}" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{Binding Theme.Foreground}" />
            <Setter Property="Background" Value="{Binding Theme.MenuBackground}" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Foreground="{TemplateBinding Foreground}" Background="{TemplateBinding Background}" Padding="8"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border></ControlTemplate></ToggleButton.Template>
                            <DockPanel><TextBlock Text="⌄" DockPanel.Dock="Right" Margin="8,0" /><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" /></DockPanel>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                            <Border Background="{Binding Theme.MenuBackground}" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="4">
                                <ScrollViewer MaxHeight="220"><ItemsPresenter /></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="760">
    <StackPanel Margin="22">
        <DockPanel Margin="0,0,0,10">
            <Button x:Name="SearchButton" Content="搜索" DockPanel.Dock="Right" Margin="8,0,0,0" Click="Search_Click" />
            <TextBox x:Name="QueryBox" MaxLength="256" />
        </DockPanel>
        <ListBox x:Name="SubjectsList" Height="280" Foreground="{Binding Theme.Foreground}" Background="{Binding Theme.MenuBackground}" BorderThickness="0" SelectionChanged="Subject_Changed">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="8,10">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="Bold" />
                        <TextBlock Text="{Binding Details}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding Rating, StringFormat=评分 {0:0.0}}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="作品类型" Margin="0,12,0,4" />
        <ComboBox x:Name="KindBox" SelectedIndex="0" Margin="0,0,0,10">
            <ComboBoxItem Content="剧集" Tag="show" /><ComboBoxItem Content="电影" Tag="movie" />
        </ComboBox>
        <TextBlock Text="季度" Margin="0,12,0,4" />
        <ComboBox x:Name="SeasonsBox" Margin="0,0,0,10" SelectionChanged="Season_Changed" />
        <TextBlock Text="当前剧集" Margin="0,12,0,4" />
        <ComboBox x:Name="EpisodesBox" Margin="0,0,0,10" SelectionChanged="Episode_Changed" />
        <TextBlock x:Name="StatusText" Foreground="{Binding Theme.Foreground2}" TextWrapping="Wrap" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="BindButton" Content="使用当前匹配" Margin="0,0,8,0" Click="Bind_Click" />
            <Button Content="关闭" Click="Close_Click" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
