<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="clr-namespace:HandyControl.Controls"
        x:Class="MpvNet.Windows.WPF.SubtitleSearchWindow"
        Title="搜索字幕" Width="560" Height="620" MinWidth="500" MinHeight="430"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" Foreground="{Binding Theme.Foreground}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" Loaded="Window_Loaded" Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="FilterButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,7,0" />
        </Style>
        <Style x:Key="AliasItem" TargetType="ListBoxItem" BasedOn="{StaticResource MatchResultItem}">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,1" />
        </Style>
        <Style x:Key="SearchSection" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter HorizontalAlignment="Stretch" />
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Margin="1" CornerRadius="8" Background="{Binding Theme.Background}"
            BorderBrush="{Binding Theme.MenuBackground}" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18" /></Border.Effect>
        <Grid Margin="18,16,18,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="SearchHeader" Margin="2,0,0,13">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="搜索字幕" FontSize="24" FontWeight="SemiBold" />
                </StackPanel>
                <Button Grid.Column="1" Content="来源设置" Click="Settings_Click" VerticalAlignment="Center" />
            </Grid>
            <Grid x:Name="FilesHeader" Margin="2,0,0,13" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Content="返回" Click="Back_Click" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="字幕文件" FontSize="22" FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center" />
                <Button x:Name="DownloadAllButton" Grid.Column="2" Content="下载全部" Click="DownloadAll_Click" IsEnabled="False" VerticalAlignment="Center" />
            </Grid>
                <ListBox x:Name="ResultsList" Grid.Row="1" Style="{StaticResource MatchList}" PreviewMouseLeftButtonUp="Result_Click" KeyDown="Result_KeyDown" BorderThickness="0" Background="Transparent"
                         ItemContainerStyle="{StaticResource MatchResultItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemsSource>
                        <CompositeCollection>
                            <ListBoxItem Style="{StaticResource SearchSection}" x:Name="SearchControls">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Grid x:Name="SearchField">
                                            <TextBox x:Name="SearchBox" Style="{StaticResource MatchTextBox}" MaxLength="160"
                                                     PreviewKeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged" Padding="13,9,48,9" />
                                            <Button x:Name="AliasesButton" Width="38" MinWidth="0" Padding="4" Margin="4"
                                                    HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="Transparent"
                                                    Foreground="{Binding Theme.Foreground2}" ToolTip="选择作品别名"
                                                    AutomationProperties.Name="选择作品别名" Click="Aliases_Click"
                                                    PreviewMouseLeftButtonDown="Aliases_PreviewMouseLeftButtonDown">
                                                <Viewbox Width="28" Height="28" IsHitTestVisible="False">
                                                    <Canvas Width="30" Height="30">
                                                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                              Data="M 3,12 A 12,12 0 0 1 25,7 M 25,2 L 25,7 L 20,7 M 27,18 A 12,12 0 0 1 5,23 M 5,28 L 5,23 L 10,23 M 19,19 L 23,23" />
                                                        <Ellipse Canvas.Left="8.5" Canvas.Top="8.5" Width="12" Height="12" StrokeThickness="1.8"
                                                                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>
                                            <Popup x:Name="AliasesPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=SearchField}"
                                                   StaysOpen="False" AllowsTransparency="True" VerticalOffset="4" PreviewKeyDown="Aliases_KeyDown">
                                                <Border Width="{Binding ActualWidth, ElementName=SearchField}" Padding="4" CornerRadius="5"
                                                        Background="{Binding Theme.MenuBackground}" BorderBrush="{Binding Theme.MenuHighlight}" BorderThickness="1">
                                                    <StackPanel>
                                                        <ListBox x:Name="AliasesList" Style="{StaticResource MatchList}" ItemContainerStyle="{StaticResource AliasItem}"
                                                                 MaxHeight="240" PreviewMouseLeftButtonUp="Alias_Click">
                                                            <ListBox.ItemTemplate><DataTemplate>
                                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                                            </DataTemplate></ListBox.ItemTemplate>
                                                        </ListBox>
                                                        <TextBlock x:Name="AliasesStatus" Margin="10,8" TextWrapping="Wrap"
                                                                   Foreground="{Binding Theme.Foreground2}" Visibility="Collapsed" />
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                        <Button x:Name="SearchButton" Grid.Column="1" Content="搜索" Margin="10,0,0,0" Click="Search_Click" />
                                    </Grid>
                                    <Grid x:Name="SourceRow" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="来源" Foreground="{Binding Theme.Foreground2}" VerticalAlignment="Center" />
                                        <hc:ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                         CanMouseWheel="False" Focusable="False" PanningMode="HorizontalFirst">
                                        <StackPanel x:Name="SourceChips" Orientation="Horizontal">
                                            <Button Content="全部" Tag="all" Style="{StaticResource FilterButton}" Click="Source_Click" />
                                            <Button Content="ASSRT" Tag="assrt" Style="{StaticResource FilterButton}" Click="Source_Click" />
                                            <Button Content="ameNZB（测试）" Tag="amenzb" Style="{StaticResource FilterButton}" Click="Source_Click" />
                                            <Button Content="TsukiHime（测试）" Tag="tsukihime" Style="{StaticResource FilterButton}" Click="Source_Click" />
                                            <Button Content="本地" Tag="local" Style="{StaticResource FilterButton}" Click="Source_Click" />
                                        </StackPanel>
                                        </hc:ScrollViewer>
                                    </Grid>
                                    <Grid x:Name="SeasonRow" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="季度" Foreground="{Binding Theme.Foreground2}" VerticalAlignment="Center" />
                                        <WrapPanel x:Name="SeasonChips" Grid.Column="1" />
                                    </Grid>
                                    <Grid x:Name="EpisodeRow" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="集数" Foreground="{Binding Theme.Foreground2}" VerticalAlignment="Center" />
                                        <hc:ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                         CanMouseWheel="False" Focusable="False" PanningMode="HorizontalFirst">
                                            <StackPanel x:Name="EpisodeChips" Orientation="Horizontal" />
                                        </hc:ScrollViewer>
                                    </Grid>
                                    <Grid x:Name="LanguageRow" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="语言" Foreground="{Binding Theme.Foreground2}" VerticalAlignment="Center" />
                                        <hc:ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                         CanMouseWheel="False" Focusable="False" PanningMode="HorizontalFirst">
                                            <StackPanel x:Name="LanguageChips" Orientation="Horizontal" />
                                        </hc:ScrollViewer>
                                    </Grid>
                                </StackPanel>
                            </ListBoxItem>
                            <CollectionContainer x:Name="ResultsCollection" />
                            <ListBoxItem Style="{StaticResource SearchSection}">
                                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                                            Margin="24,12" IsHitTestVisible="False" Visibility="Collapsed">
                                    <TextBlock x:Name="EmptyHeading" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" />
                                    <TextBlock x:Name="EmptyDescription" Margin="0,8,0,0" Foreground="{Binding Theme.Foreground2}"
                                               TextWrapping="Wrap" TextAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                        </CompositeCollection>
                    </ListBox.ItemsSource>
                    <ListBox.ItemTemplate><DataTemplate>
                        <Grid MinHeight="84">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Background="{Binding DataContext.Theme.MenuBackground, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Width="58" Height="68" CornerRadius="4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FormatLabel}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,2,2,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Details}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{Binding DataContext.Theme.Foreground2, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                        <DataTrigger Binding="{Binding Details}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            <ListBox x:Name="FilesList" Grid.Row="1" Style="{StaticResource MatchList}" Visibility="Collapsed"
                     ItemContainerStyle="{StaticResource MatchResultItem}" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonUp="File_Click" KeyDown="File_KeyDown"
                     VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate><DataTemplate>
                    <StackPanel MinHeight="50" Margin="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Size}" Margin="0,5,0,0"
                                   Foreground="{Binding DataContext.Theme.Foreground2, RelativeSource={RelativeSource AncestorType=Window}}">
                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                <DataTrigger Binding="{Binding Size}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="FilesEmpty" Grid.Row="1" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,12" TextWrapping="Wrap"
                       Visibility="Collapsed" IsHitTestVisible="False" />
            <StackPanel x:Name="SearchSummary" Grid.Row="2" Margin="2,8,2,0" VerticalAlignment="Center">
                <TextBlock x:Name="ResultCount" Text="共 0 条搜索结果" Foreground="{Binding Theme.Foreground2}" />
                <TextBlock x:Name="Status" Style="{StaticResource MatchStatusText}" />
            </StackPanel>
            <StackPanel x:Name="FilesSummary" Grid.Row="2" Margin="2,8,2,0" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="FileCount" Foreground="{Binding Theme.Foreground2}" />
                <TextBlock x:Name="FileStatus" Style="{StaticResource MatchStatusText}" />
            </StackPanel>
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button Content="字幕目录" VerticalAlignment="Center" Click="Folder_Click" />
                <TextBlock Grid.Column="1" Margin="10,0" VerticalAlignment="Center" FontSize="12"
                           Foreground="{Binding Theme.Foreground2}" TextWrapping="Wrap"
                           Text="字幕未自动加载时，可从字幕目录拖入或粘贴到视频中。" />
                <Button Grid.Column="2" Content="关闭" VerticalAlignment="Center" IsCancel="True" Click="Close_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
