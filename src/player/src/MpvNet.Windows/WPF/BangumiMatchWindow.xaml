<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MpvNet.Windows.WPF.BangumiMatchWindow"
        Title="匹配 Bangumi" Style="{StaticResource MatchWindow}" SizeToContent="Height" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource MatchTextBox}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource MatchComboBox}" />
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="760">
    <StackPanel Margin="22">
        <DockPanel Margin="0,0,0,10">
            <Button x:Name="SearchButton" Content="搜索" DockPanel.Dock="Right" Margin="8,0,0,0" Click="Search_Click" />
            <TextBox x:Name="QueryBox" MaxLength="256" />
        </DockPanel>
        <ListBox x:Name="SubjectsList" Style="{StaticResource MatchSubjectsList}" SelectionChanged="Subject_Changed" />
        <TextBlock Text="当前剧集" Margin="0,12,0,4" />
        <ComboBox x:Name="EpisodesBox" Margin="0,0,0,10" SelectionChanged="Episode_Changed" />
        <TextBlock x:Name="StatusText" Style="{StaticResource MatchStatusText}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="BindButton" Content="使用当前匹配" Margin="0,0,8,0" Click="Bind_Click" />
            <Button Content="关闭" Click="Close_Click" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
