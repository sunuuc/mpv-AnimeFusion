<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MpvNet.Windows.WPF.SubtitleSourcesWindow"
        Title="字幕来源设置" Width="500" SizeToContent="Height" MaxHeight="740" MinWidth="420"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Foreground="{Binding Theme.Foreground}" Background="{Binding Theme.Background}" FontSize="14"
        UseLayoutRounding="True" Closed="Window_Closed">
    <Window.Resources>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{Binding Theme.MenuBackground}" />
            <Setter Property="Foreground" Value="{Binding Theme.Foreground}" />
            <Setter Property="CaretBrush" Value="{Binding Theme.Foreground}" />
            <Setter Property="BorderBrush" Value="{Binding Theme.MenuHighlight}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22,18">
            <TextBlock Text="字幕来源设置" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18" />
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="获取密钥" Tag="https://secure.assrt.net/usercp.php" Click="Website_Click" />
                <TextBlock Text="ASSRT" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="API 密钥" Margin="0,4,0,6" />
            <PasswordBox x:Name="AssrtTokenBox" MaxLength="128" />
            <Button x:Name="VerifyButton" Content="验证" HorizontalAlignment="Left" Margin="0,10,0,0" Click="Verify_Click" />
            <TextBlock x:Name="AssrtStatus" Style="{StaticResource MatchStatusText}" Margin="0,8,0,0" />
            <Button Content="关闭" IsCancel="True" HorizontalAlignment="Right" Margin="0,20,0,0" Click="Close_Click" />
        </StackPanel>
    </ScrollViewer>
</Window>
