From a83aaeb4e60fdd7ed01619885f4f42bb0ef34eaa Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Kacper=20Michaj=C5=82ow?= <kasper93@gmail.com>
Date: Thu, 29 Oct 2026 03:05:31 +0100
Subject: [PATCH] shaders/icc: ignore a luminance tag without a positive
 luminance

Avoids division by 0 later on, likely not realistic, but we can make it
defensive.
---
 src/shaders/icc.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/shaders/icc.c b/src/shaders/icc.c
index 8c4855281b..aaa1dd65e3 100644
--- a/src/shaders/icc.c
+++ b/src/shaders/icc.c
@@ -294,7 +294,7 @@ static bool detect_contrast(struct pl_icc_object_t *icc,
     float max_luma = params->max_luma;
     p->white = cmsReadTag(p->profile, cmsSigLuminanceTag);
     if (max_luma <= 0)
-        max_luma = p->white ? p->white->Y : PL_COLOR_SDR_WHITE;
+        max_luma = p->white && p->white->Y > 0 ? p->white->Y : PL_COLOR_SDR_WHITE;
 
     hdr->max_luma = max_luma;
     hdr->min_luma = p->black.Y * max_luma;
