Subject: [PATCH] vulkan/swapchain: bound image acquisition when surface progress stops

An inaccessible surface must not keep the caller's video output thread in
vkAcquireNextImageKHR forever. Vulkan requires a finite timeout when surface
forward progress cannot be guaranteed (VUID-vkAcquireNextImageKHR-surface-07783).
Return false on timeout through the existing unavailable-frame path, allowing
the caller to process events and try another frame later.

diff --git a/src/vulkan/swapchain.c b/src/vulkan/swapchain.c
--- a/src/vulkan/swapchain.c
+++ b/src/vulkan/swapchain.c
@@ -855,7 +855,9 @@
         PL_TRACE(vk, "vkAcquireNextImageKHR signals 0x%"PRIx64, (uint64_t) sem_in);
 
         uint32_t imgidx = 0;
-        VkResult res = vk->AcquireNextImageKHR(vk->dev, p->current->swapchain, UINT64_MAX,
+        // An inaccessible surface may stop making forward progress. Return
+        // to the caller so it can process events instead of waiting forever.
+        VkResult res = vk->AcquireNextImageKHR(vk->dev, p->current->swapchain, 1000000000ULL,
                                                sem_in, VK_NULL_HANDLE, &imgidx);
 
         switch (res) {
@@ -886,6 +888,11 @@
             // keep lock held
             return true;
 
+        case VK_TIMEOUT:
+        case VK_NOT_READY:
+            pl_mutex_unlock(&p->lock);
+            return false;
+
         case VK_ERROR_OUT_OF_DATE_KHR: {
             // In these cases try recreating the swapchain
             if (!vk_sw_recreate(sw, 0, 0)) {
