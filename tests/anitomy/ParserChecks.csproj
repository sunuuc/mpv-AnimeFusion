<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AnitomySourceDirectory Condition="'$(AnitomySourceDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\third_party\anitomysharp</AnitomySourceDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(AnitomySourceDirectory)\*.cs" Link="Anitomy\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
